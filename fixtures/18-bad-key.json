{
  "name": "bad_key",
  "description": "401.",
  "call": {
    "product": "instant_snap",
    "method": "capture",
    "options": {
      "url": "https://example.com"
    }
  },
  "expect_requests": [
    {
      "method": "POST",
      "path": "/instant-snap/v1/captures",
      "headers": {
        "X-Api-Key": "wsw_api_000000000000_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "Content-Type": "application/json"
      },
      "idempotency_key": "same",
      "body": {
        "url": "https://example.com",
        "response_type": "json"
      }
    }
  ],
  "responses": [
    {
      "status": 401,
      "headers": {
        "Content-Type": "application/json; charset=utf-8"
      },
      "body": {
        "success": false,
        "error_code": "api_key_invalid",
        "error_message": "\"X-Api-Key\" is invalid.",
        "retry_after_seconds": null
      }
    }
  ],
  "expect": {
    "error": {
      "kind": "authentication",
      "error_code": "api_key_invalid",
      "http_status": 401
    }
  }
}
