{
  "name": "account",
  "description": "Whose key this is: the key’s name and prefix, its product and the creator’s email (Instant Snap API 1.4.0).",
  "call": {
    "product": "instant_snap",
    "method": "account"
  },
  "expect_requests": [
    {
      "method": "GET",
      "path": "/instant-snap/v1/account",
      "headers": {
        "X-Api-Key": "wsw_api_000000000000_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      }
    }
  ],
  "responses": [
    {
      "status": 200,
      "headers": {
        "Content-Type": "application/json; charset=utf-8"
      },
      "body": {
        "success": true,
        "key_name": "Zapier",
        "key_prefix": "000000000000",
        "product": "instant_snap",
        "email": "you@example.com"
      }
    }
  ],
  "expect": {
    "result": {
      "key_name": "Zapier",
      "key_prefix": "000000000000",
      "product": "instant_snap",
      "email": "you@example.com"
    }
  }
}
