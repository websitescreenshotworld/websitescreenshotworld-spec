{
  "openapi": "3.1.0",
  "info": {
    "title": "Auto Schedule API",
    "version": "1.2.1",
    "description": "Start a scheduled web page's capture now. Results arrive by webhook (capture.succeeded, capture.failed, delivery.completed, capture.changed, sitemap_run.completed).",
    "contact": {
      "email": "support@websitescreenshotworld.com"
    }
  },
  "servers": [
    {
      "url": "https://autoapi.websitescreenshotworld.com"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/auto-schedule/v1/web-pages/{web_page_id}/trigger-now": {
      "post": {
        "operationId": "triggerNow",
        "summary": "Capture a web page now",
        "description": "The web page is created in the dashboard; its id is the `schedule_id` in webhooks. Idempotent: a second call while the first capture is pending answers `already_pending`.",
        "parameters": [
          {
            "name": "web_page_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Queued, or already pending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriggerResult"
                }
              }
            }
          },
          "400": {
            "description": "The id is not a web page id. Codes: `web_page_id_invalid`, `validation_failed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bad key. Codes: `api_key_invalid`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The plan does not allow it. Codes: `feature_not_available`, `no_trigger_allowance`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such web page for this account. Codes: `web_page_not_found`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The web page is a sitemap schedule, which runs only on its schedule. Codes: `sitemap_schedule_not_triggerable`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Codes: `rate_limited`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "A service is down; retry after the hint. Codes: `service_unavailable`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "/auto-schedule/v1/webhook-endpoints": {
      "get": {
        "operationId": "listWebhookEndpoints",
        "summary": "List webhook endpoints",
        "description": "Every webhook endpoint of the key's organization, whoever added it. Takes an Auto Schedule key; the same list is managed with an Instant Snap key at /instant-snap/v1/webhook-endpoints.",
        "responses": {
          "200": {
            "description": "The endpoints.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpointList"
                }
              }
            }
          },
          "401": {
            "description": "Bad key. Codes: `api_key_invalid`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Codes: `rate_limited`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "A service is down; retry after the hint. Codes: `service_unavailable`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWebhookEndpoint",
        "summary": "Add a webhook endpoint",
        "description": "Adds an endpoint to the organization, for an integration that registers its own webhook (n8n, Zapier, Make). It gets a signing secret of its own, returned only in this answer. An organization can have 25 endpoints. Takes an Auto Schedule key; the same list is managed with an Instant Snap key at /instant-snap/v1/webhook-endpoints.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEndpointCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added. Store `signing_secret` now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpointCreated"
                }
              }
            }
          },
          "400": {
            "description": "The URL cannot receive webhooks, or an event or product is not known. Codes: `validation_failed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such schedule for `web_page_id`. Codes: `web_page_not_found`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The organization already has 25 endpoints. Codes: `webhook_endpoint_limit_reached`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bad key. Codes: `api_key_invalid`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The plan has no webhooks (the free trial). Codes: `feature_not_available`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Codes: `rate_limited`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "A service is down; retry after the hint. Codes: `service_unavailable`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "/auto-schedule/v1/webhook-endpoints/{id}": {
      "get": {
        "operationId": "getWebhookEndpoint",
        "summary": "Read a webhook endpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
          },
          "404": {
            "description": "No such endpoint in the key's organization. Codes: `webhook_endpoint_not_found`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bad key. Codes: `api_key_invalid`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Codes: `rate_limited`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "A service is down; retry after the hint. Codes: `service_unavailable`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteWebhookEndpoint",
        "summary": "Delete a webhook endpoint",
        "description": "Nothing more is posted to it. Deliveries already in the log stay there.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpointDeleted"
                }
              }
            }
          },
          "404": {
            "description": "No such endpoint in the key's organization. Codes: `webhook_endpoint_not_found`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bad key. Codes: `api_key_invalid`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Codes: `rate_limited`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "A service is down; retry after the hint. Codes: `service_unavailable`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "schemas": {
      "TriggerResult": {
        "type": "object",
        "required": [
          "success",
          "status",
          "web_page_id",
          "triggered_by",
          "triggered_at",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "status": {
            "type": "string",
            "enum": [
              "triggered",
              "already_pending"
            ],
            "description": "`already_pending`: a capture for this web page is already queued or running; nothing new was started and nothing was charged."
          },
          "web_page_id": {
            "type": "string",
            "format": "uuid"
          },
          "triggered_by": {
            "type": "string",
            "enum": [
              "api",
              "ui"
            ]
          },
          "triggered_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the capture was queued (for `already_pending`, the original trigger). UTC, ISO 8601 with milliseconds."
          },
          "message": {
            "type": "string",
            "description": "One sentence for a person."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error_code",
          "error_message",
          "retry_after_seconds"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error_code": {
            "type": "string",
            "examples": [
              "rate_limited"
            ],
            "description": "A stable, lowercase token. Switch on this, never on the HTTP status or the message."
          },
          "error_message": {
            "type": "string",
            "description": "One sentence for a person. The wording can change between releases."
          },
          "retry_after_seconds": {
            "description": "Seconds to wait before retrying. Set on rate_limited, capture_busy, service_unavailable and idempotency_key_in_use; mirrors the Retry-After header.",
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "WebhookEventName": {
        "type": "string",
        "enum": [
          "capture.succeeded",
          "capture.failed",
          "capture.changed",
          "delivery.completed",
          "schedule.paused",
          "sitemap_run.completed"
        ]
      },
      "WebhookEndpoint": {
        "type": "object",
        "description": "A webhook endpoint of the key's organization. The same list the app shows under Developer Tools, Webhooks. Never carries a secret.",
        "required": [
          "success",
          "id",
          "name",
          "url",
          "events",
          "product",
          "web_page_id",
          "is_enabled",
          "has_own_secret",
          "disabled_reason",
          "last_delivery_at",
          "last_status_code",
          "created_at"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookEventName"
            }
          },
          "product": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "auto_schedule",
              "instant_snap",
              null
            ],
            "description": "Limited to one product's events; null for both."
          },
          "web_page_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Limited to one schedule's events; null for every schedule."
          },
          "is_enabled": {
            "type": "boolean",
            "description": "False once the endpoint was switched off, by its owner or after 20 failed deliveries in a row."
          },
          "has_own_secret": {
            "type": "boolean",
            "description": "True when deliveries are signed with this endpoint's own secret (created through this API); false when they are signed with the organization's secret (added in the app)."
          },
          "disabled_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_delivery_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_status_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WebhookEndpointItem": {
        "type": "object",
        "description": "A webhook endpoint of the key's organization. The same list the app shows under Developer Tools, Webhooks. Never carries a secret.",
        "required": [
          "id",
          "name",
          "url",
          "events",
          "product",
          "web_page_id",
          "is_enabled",
          "has_own_secret",
          "disabled_reason",
          "last_delivery_at",
          "last_status_code",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookEventName"
            }
          },
          "product": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "auto_schedule",
              "instant_snap",
              null
            ],
            "description": "Limited to one product's events; null for both."
          },
          "web_page_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Limited to one schedule's events; null for every schedule."
          },
          "is_enabled": {
            "type": "boolean",
            "description": "False once the endpoint was switched off, by its owner or after 20 failed deliveries in a row."
          },
          "has_own_secret": {
            "type": "boolean",
            "description": "True when deliveries are signed with this endpoint's own secret (created through this API); false when they are signed with the organization's secret (added in the app)."
          },
          "disabled_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_delivery_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_status_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WebhookEndpointList": {
        "type": "object",
        "required": [
          "success",
          "items"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookEndpointItem"
            }
          }
        }
      },
      "WebhookEndpointCreate": {
        "type": "object",
        "required": [
          "url",
          "events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Where to post: a public https address."
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/WebhookEventName"
            }
          },
          "name": {
            "type": "string",
            "maxLength": 128,
            "description": "What the endpoint is called in the app. Default: \"Added through the API\"."
          },
          "product": {
            "type": "string",
            "enum": [
              "auto_schedule",
              "instant_snap"
            ],
            "description": "Take only this product's events. Leave out for both."
          },
          "web_page_id": {
            "type": "string",
            "format": "uuid",
            "description": "Take only this schedule's events."
          }
        }
      },
      "WebhookEndpointCreated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/WebhookEndpoint"
          },
          {
            "type": "object",
            "required": [
              "signing_secret"
            ],
            "properties": {
              "signing_secret": {
                "type": "string",
                "description": "The secret deliveries to this endpoint are signed with (X-WSW-Signature). Returned only here: store it now. Starts with whsec_."
              }
            }
          }
        ]
      },
      "WebhookEndpointDeleted": {
        "type": "object",
        "required": [
          "success",
          "id",
          "deleted"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deleted": {
            "type": "boolean",
            "const": true
          }
        }
      }
    }
  }
}
